test_stale_hammerspoon_record_names_the_fix() {
    printf 'hammerspoon 1.1.0\n' > "$TEST_TMPDIR/brew-casks"
    run_setup --ignore-errors
    assert_status 0 &&
    assert_not_called "brew install --cask hammerspoon" &&
    assert_output_contains "Homebrew lists hammerspoon 1.1.0 as installed but Hammerspoon is missing" &&
    assert_output_contains "run 'brew uninstall --cask --force hammerspoon' and rerun tide-setup"
}

test_setup_command_names_what_to_rerun() {
    printf 'hammerspoon 1.1.0\n' > "$TEST_TMPDIR/brew-casks"
    SETUP_COMMAND=setup run_setup --ignore-errors
