# asks for a password, and tide's Option rule copied into its folder.
test_super_defaults_to_left_option() {
    run_setup
    assert_status 0 &&
    assert_called "brew install --cask karabiner-elements" &&
    assert_output_contains "asks for your password" &&
    assert_file_contains "$RULE" '"description": "tide: left Option+key'
}

test_super_win_installs_the_rotation_rule() {
    run_setup --super win
    assert_status 0 &&
    assert_file_contains "$RULE" '"description": "tide: Win+key'
}

test_super_equals_syntax() {
    run_setup --super=win
    assert_status 0 &&
    assert_file_contains "$RULE" '"description": "tide: Win+key'
