# Rerun with --super none, the rule an earlier run installed goes, so tide
# turns its enabled copy off.
test_super_none_removes_an_earlier_rule() {
    run_setup --super option
    assert_file_contains "$RULE" "tide:" || return 1
    run_setup --super none
    assert_status 0 &&
    assert_output_contains "Removing tide's Karabiner rule" || return 1
    if test -e "$RULE" || test -L "$RULE"; then
        fail "the rule is still there"
    fi
}

test_super_none_leaves_a_rule_not_tides() {
    mkdir -p "${RULE%/*}"
