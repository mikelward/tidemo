test_writes_hammerspoon_init() {
    run_setup
    assert_status 0 &&
    assert_file_contains "$TEST_TMPDIR/home/.hammerspoon/init.lua" 'tide = require("tide")' &&
    assert_file_contains "$TEST_TMPDIR/home/.hammerspoon/init.lua" 'tide.start({})'
}

test_leaves_an_existing_init_alone() {
    mkdir -p "$TEST_TMPDIR/home/.hammerspoon"
    printf '%s\n' 'hs.alert.show("mine")' > "$TEST_TMPDIR/home/.hammerspoon/init.lua"
    run_setup
    assert_status 0 &&
    assert_file_contains "$TEST_TMPDIR/home/.hammerspoon/init.lua" 'hs.alert.show("mine")' &&
    assert_file_lacks "$TEST_TMPDIR/home/.hammerspoon/init.lua" 'require("tide")' &&
    assert_output_contains "doesn't load tide, so it was left alone" &&
    assert_output_contains 'tide = require("tide")'
}

test_accepts_an_init_that_loads_tide() {
    mkdir -p "$TEST_TMPDIR/home/.hammerspoon"
    printf '%s\n' "local t = require 'tide'" 't.start({})' \
        > "$TEST_TMPDIR/home/.hammerspoon/init.lua"
    run_setup --verbose
    assert_status 0 &&
    assert_output_contains "it already loads tide" &&
    assert_output_lacks "doesn't load tide"
}

# tide keeps require("tilemo") and require("timo") as shims.
test_accepts_an_init_that_loads_an_old_name() {
    mkdir -p "$TEST_TMPDIR/home/.hammerspoon"
    printf '%s\n' 'timo = require("timo")' 'timo.start({})' \
        > "$TEST_TMPDIR/home/.hammerspoon/init.lua"
    run_setup --verbose
    assert_status 0 &&
    assert_output_contains "it already loads tide"
}

test_does_not_count_a_commented_out_require() {
    mkdir -p "$TEST_TMPDIR/home/.hammerspoon"
    printf '%s\n' '-- tide = require("tide")' > "$TEST_TMPDIR/home/.hammerspoon/init.lua"
    run_setup
    assert_status 0 &&
    assert_output_contains "doesn't load tide, so it was left alone"
}

test_does_not_replace_a_dangling_init_symlink() {
    mkdir -p "$TEST_TMPDIR/home/.hammerspoon"
    ln -s "$TEST_TMPDIR/nowhere/init.lua" "$TEST_TMPDIR/home/.hammerspoon/init.lua"
    run_setup
    assert_status 0 &&
    assert_output_contains "could not read $TEST_TMPDIR/home/.hammerspoon/init.lua" || return 1
    test -L "$TEST_TMPDIR/home/.hammerspoon/init.lua" || fail "the init.lua symlink was replaced"
}

