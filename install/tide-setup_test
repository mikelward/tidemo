#!/bin/bash
# Tests for install/tide-setup, tide's macOS installer.
#
# It runs against a throwaway HOME with Homebrew, defaults, make and the other
# macOS tools mocked, and the assertions look at what it asked them to do, so
# these run on Linux CI too. The sandbox PATH holds only the mocks and a few
# system utilities, never /usr/bin, so a run on a Mac can't reach the real
# defaults and change the developer's shortcuts.

set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
SETUP_SCRIPT="$SCRIPT_DIR/tide-setup"

TESTS_RUN=0
TESTS_PASSED=0
TESTS_FAILED=0

setup() {
    TEST_TMPDIR="$(mktemp -d)"
    CALLS="$TEST_TMPDIR/calls"
    mkdir -p "$TEST_TMPDIR/bin" "$TEST_TMPDIR/home"

    # Every command records its argv; defaults fails a write where
    # defaults_write_fails is staged.
    cat > "$TEST_TMPDIR/bin/defaults" <<MOCK
#!/bin/sh
printf "%s\\n" "defaults \$*" >> "$CALLS"
if test "\$1" = write && test -f "$TEST_TMPDIR/defaults_write_fails"; then
    echo "defaults: could not write domain" >&2
    exit 1
fi
exit 0
MOCK

    # brew records the environment that keeps it from asking. brew list
    # answers from brew-casks, one "name version" line per cask it has a
    # record of; brew_fails.<formula> fails that install.
    cat > "$TEST_TMPDIR/bin/brew" <<MOCK
#!/bin/sh
printf "%s\\n" "brew \$* [HOMEBREW_NO_ASK=\${HOMEBREW_NO_ASK:-unset}]" >> "$CALLS"
if test "\$1" = list; then
    for _arg; do _cask="\$_arg"; done
    grep "^\$_cask " "$TEST_TMPDIR/brew-casks" 2>/dev/null || exit 1
    exit 0
fi
for _arg; do _last="\$_arg"; done
if test -f "$TEST_TMPDIR/brew_fails.\$_last"; then
    echo "Error: no bottle for \$_last"
    exit 1
fi
exit 0
MOCK

    # pgrep says Amethyst and Rectangle aren't running, nor System Settings;
    # running.<name> says one is, and pgrep_fails.<name> that pgrep can't say.
    cat > "$TEST_TMPDIR/bin/pgrep" <<MOCK
#!/bin/sh
printf "%s\\n" "pgrep \$*" >> "$CALLS"
test -f "$TEST_TMPDIR/pgrep_fails.\$2" && exit 3
test -f "$TEST_TMPDIR/running.\$2" && exit 0
exit 1
MOCK

    cat > "$TEST_TMPDIR/bin/make" <<MOCK
#!/bin/sh
printf "%s\\n" "make \$*" >> "$CALLS"
test -f "$TEST_TMPDIR/make_fails" && exit 2
echo "Add to init.lua: (make's own note)"
exit 0
MOCK

    cat > "$TEST_TMPDIR/bin/open" <<MOCK
#!/bin/sh
printf "%s\\n" "open \$*" >> "$CALLS"
exit 0
MOCK

    cat > "$TEST_TMPDIR/bin/activateSettings" <<MOCK
#!/bin/sh
printf "%s\\n" "activateSettings \$*" >> "$CALLS"
exit 0
MOCK
    ACTIVATE_SETTINGS="$TEST_TMPDIR/bin/activateSettings"

    fake_arch arm64
    chmod +x "$TEST_TMPDIR"/bin/*

    mkdir -p "$TEST_TMPDIR/sysbin"
    for cmd in awk cat dirname grep mkdir mktemp mv rm sed tail tr wc; do
        ln -sf "$(command -v "$cmd")" "$TEST_TMPDIR/sysbin/$cmd"
    done

    APPLICATIONS_DIR="$TEST_TMPDIR/Applications"
    USER_APPLICATIONS_DIR="$TEST_TMPDIR/home/Applications"
    mkdir -p "$APPLICATIONS_DIR"
    SETUP_TODO=
    SETUP_PROBLEMS=
    RULE="$TEST_TMPDIR/home/.config/karabiner/assets/complex_modifications/tide.json"
}

teardown() {
    rm -rf "$TEST_TMPDIR"
}

fake_arch() {
    printf '#!/bin/sh\necho %s\n' "$1" > "$TEST_TMPDIR/bin/uname"
    chmod +x "$TEST_TMPDIR/bin/uname"
}

# Install a fake NAME.app in the sandboxed /Applications.
add_app() {
    mkdir -p "$APPLICATIONS_DIR/$1.app/Contents/MacOS"
    printf 'app\n' > "$APPLICATIONS_DIR/$1.app/Contents/Info.plist"
}

# Put a do-nothing NAME on PATH, as an installed command.
add_command() {
    printf '#!/bin/sh\nexit 0\n' > "$TEST_TMPDIR/bin/$1"
    chmod +x "$TEST_TMPDIR/bin/$1"
}

# A machine with everything installed already.
stage_installed() {
    add_app Hammerspoon
    add_app Karabiner-Elements
    add_app LinearMouse
    add_command blueutil
    add_command m1ddc
}

# Runs the installer in the sandbox, with the commands named in $MISSING
# taken off PATH.
run_setup() {
    rm -rf "$TEST_TMPDIR/path"
    mkdir -p "$TEST_TMPDIR/path"
    for f in "$TEST_TMPDIR"/bin/*; do
        case " ${MISSING:-} " in
            *" ${f##*/} "*) continue ;;
        esac
        cp "$f" "$TEST_TMPDIR/path/"
    done
    set +e
    output="$(HOME="$TEST_TMPDIR/home" \
        XDG_STATE_HOME="$TEST_TMPDIR/home/.local/state" \
        ACTIVATE_SETTINGS="$ACTIVATE_SETTINGS" \
        APPLICATIONS_DIR="$APPLICATIONS_DIR" \
        USER_APPLICATIONS_DIR="$USER_APPLICATIONS_DIR" \
        SETUP_TODO="$SETUP_TODO" \
        SETUP_PROBLEMS="$SETUP_PROBLEMS" \
        SETUP_COMMAND="${SETUP_COMMAND:-}" \
        PATH="$TEST_TMPDIR/path:$TEST_TMPDIR/sysbin" \
        "$SETUP_SCRIPT" "$@" </dev/null 2>&1)"
    status=$?
    set -e
}

fail() {
    printf "  FAIL: %s\n" "$1"
    printf "  output: %s\n" "$output"
    TEST_FAILED=1
    return 1
}

assert_status() {
    test "$status" -eq "$1" || fail "expected exit status $1, got $status"
}

assert_output_contains() {
    case "$output" in
        *"$1"*) ;;
        *) fail "output does not contain '$1'" ;;
    esac
}

assert_output_lacks() {
    case "$output" in
        *"$1"*) fail "output unexpectedly contains '$1'" ;;
    esac
}

# The output with its lines joined, so a sentence matches however it wraps.
assert_says() {
    case "$(printf '%s\n' "$output" | tr '\n' ' ' | tr -s ' ')" in
        *"$1"*) ;;
        *) fail "output does not say '$1'" ;;
    esac
}

assert_called() {
    grep -qF -- "$1" "$CALLS" 2>/dev/null ||
        fail "expected call '$1' not found; calls: $(cat "$CALLS" 2>/dev/null)"
}

assert_not_called() {
    if grep -qF -- "$1" "$CALLS" 2>/dev/null; then
        fail "unexpected call '$1' found"
    fi
}

assert_file_contains() {
    grep -qF -- "$2" "$1" 2>/dev/null || fail "'$1' does not contain '$2'"
}

assert_file_lacks() {
    if grep -qF -- "$2" "$1" 2>/dev/null; then
        fail "'$1' unexpectedly contains '$2'"
    fi
}

# One whole symbolic hotkey entry: ID, enabled, and its three parameters.
assert_hotkey() {
    _want="-dict-add $1 <dict> <key>enabled</key><$2/> <key>value</key><dict> <key>parameters</key><array> <integer>$3</integer> <integer>$4</integer> <integer>$5</integer> </array>"
    tr -s ' \n\t' '   ' < "$CALLS" | grep -qF -- "$_want" ||
        fail "expected hotkey write '$_want' not found"
}

