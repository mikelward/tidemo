}

test_no_install_skips_hammerspoon() {
    run_setup --no-install --ignore-errors
    assert_status 0 &&
    assert_not_called "brew install" &&
    assert_output_contains "Hammerspoon is not installed and --no-install was given" &&
    assert_output_contains "blueutil is not installed and --no-install was given; tide's bar won't show whether Bluetooth is on until it is" &&
