    printf 'conf\n' > "$TEST_TMPDIR/conf/tide.json"
    ln -s "$TEST_TMPDIR/conf/tide.json" "$RULE"
    run_setup
    assert_status 0 &&
    assert_file_contains "$RULE" "tide: left Option" &&
    assert_file_contains "$TEST_TMPDIR/conf/tide.json" "conf" || return 1
    if test -L "$RULE"; then
        fail "the rule is still a link"
    fi
}

# --- Under setup ---

# setup lists what's left with its own, so the installer hands it over.
test_hands_what_to_do_to_setup() {
    SETUP_TODO="$TEST_TMPDIR/todo"
    run_setup
    assert_status 0 &&
    assert_output_lacks "Still to do by hand" &&
    assert_file_contains "$SETUP_TODO" "todo	Turn on Accessibility for Hammerspoon. tide runs in it, and can't tile without it.	In System Settings" &&
    assert_file_contains "$SETUP_TODO" "logout	the menu bar setting"
}

# Its warnings go to setup's list, and setup repeats them, not it.
test_adds_warnings_to_setups_list() {
    SETUP_PROBLEMS="$TEST_TMPDIR/problems"
    : > "$SETUP_PROBLEMS"
    add_app Amethyst
    run_setup
    assert_status 0 &&
    assert_file_contains "$SETUP_PROBLEMS" "Warning: Amethyst is installed" &&
    assert_output_lacks "the warnings and errors from this run, again"
}

test_repeats_its_warnings_on_its_own() {
    add_app Amethyst
    run_setup
    assert_status 0 &&
    assert_output_contains "tide-setup: the warnings and errors from this run, again:"
}

run_test() {
    name="$1"
    func="$2"
    TESTS_RUN=$((TESTS_RUN + 1))
    setup
    TEST_FAILED=
    MISSING=
    if "$func" && test -z "$TEST_FAILED"; then
        echo "ok $TESTS_RUN $name"
        TESTS_PASSED=$((TESTS_PASSED + 1))
    else
        echo "not ok $TESTS_RUN $name"
        TESTS_FAILED=$((TESTS_FAILED + 1))
    fi
    teardown
}

