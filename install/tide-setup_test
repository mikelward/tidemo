# Optional: no Karabiner, and Super stays plain Option.
test_super_none_leaves_karabiner_out() {
    run_setup --super none
    assert_status 0 &&
    assert_not_called "karabiner" &&
    assert_output_contains "Super is plain Option" || return 1
    if test -e "$RULE"; then
        fail "a rule was written"
    fi
