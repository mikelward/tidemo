}

test_needs_defaults() {
    MISSING=defaults run_setup
    assert_status 1 &&
    assert_output_contains "defaults is required"
}

# --- A clean run ---

test_clean_run() {
    stage_installed
    run_setup
    assert_status 0 &&
    assert_output_contains "tide installed" &&
    assert_output_lacks "Warning" &&
    assert_not_called "brew install"
}

